# Optional destination folder. If omitted, uploads to My Drive root.
MEETING_RECORDER_DRIVE_FOLDER_ID=
MEETING_RECORDER_GUEST_NAME="Hermes Meeting Recorder"

# REQUIRED for audio. Set this after PulseAudio/PipeWire setup, typically:
# MEETING_RECORDER_PULSE_SOURCE=hermes_record.monitor
MEETING_RECORDER_PULSE_SOURCE=

# Verify FFmpeg remains alive before joining Meet.
MEETING_RECORDER_FFMPEG_STARTUP_CHECK_SECONDS=2

# Virtual screen captured by FFmpeg. Larger than Chromium's 1280x800 viewport
# so browser chrome and the complete Meet tab are not clipped.
MEETING_RECORDER_SCREEN_SIZE=1366x900

# Optional Y4M file broadcast by the recorder's virtual camera. When set, the
# recorder keeps its Meet camera on; when empty, the camera remains off.
MEETING_RECORDER_CAMERA_IMAGE=

# Empty disables the in-meeting recording notice. Customize as needed.
MEETING_RECORDER_CHAT_MESSAGE="This meeting is being recorded by Hermes Meeting Recorder."

# Leave only after the bot is alone for 3 consecutive participant checks.
MEETING_RECORDER_PARTICIPANT_POLL_SECONDS=10
MEETING_RECORDER_EMPTY_CONFIRMATIONS=3

# Completion notification after the recorder leaves and upload finishes.
# Empty disables it. Format: platform:chat_id[:thread_id].
MEETING_RECORDER_NOTIFICATION_TARGET=discord:948411835877564486:1521852955970502696

# Optionally share only recordings from these exact Meet rooms with one reader.
MEETING_RECORDER_SHARE_EMAIL=
MEETING_RECORDER_SHARE_MEET_URLS=
